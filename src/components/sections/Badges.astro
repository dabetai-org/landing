---
import type { Dictionary } from "../../i18n/types";

const { className = "", dict } = Astro.props as { className?: string; dict: Dictionary };
---

<div class={`flex xs:flex-col sm:flex-row items-center gap-3 select-none ${className}`}>
  <div class="relative group cursor-default">
    <img src="/assets/images/badge/google-play-badge.png" alt="Google Play" class="w-28 xs:w-32 lg:w-36 opacity-80 transition-opacity duration-200 group-hover:opacity-60" />
    <span class="absolute -top-7 left-1/2 -translate-x-1/2 bg-slate-700 text-slate-50 text-[10px] font-inter font-bold px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none shadow-ds-sm">
      {dict.badges.comingSoon}
    </span>
  </div>
  <div class="relative group cursor-default">
    <img src="/assets/images/badge/app-store-badge.png" alt="App Store" class="w-28 xs:w-32 lg:w-36 opacity-80 transition-opacity duration-200 group-hover:opacity-60" />
    <span class="absolute -top-7 left-1/2 -translate-x-1/2 bg-slate-700 text-slate-50 text-[10px] font-inter font-bold px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none shadow-ds-sm">
      {dict.badges.comingSoon}
    </span>
  </div>
</div>
