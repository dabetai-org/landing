---
import Badges from "../Badges.astro";
import Section from "../../layout/Section.astro";
import Typography from "../../ui/Typography.astro";
---

<Section bgColor="bg-slate-50" innerClass="lg:flex-row justify-between items-center">
  <div class="flex flex-col gap-4 sm:gap-5 text-center lg:text-left">
    <Typography variant="h1" color="text-slate-950">
      Anticípate a las complicaciones con el poder de la IA
    </Typography>
    <Typography variant="body">
      Próximamente disponible. Conecta tu CGM y wearables, y deja que la IA cuide de tu salud.
    </Typography>
  </div>
  <Badges className="flex flex-col sm:flex-row lg:flex-col justify-center lg:justify-end items-center w-full sm:w-auto" />
</Section>
