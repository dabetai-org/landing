---
import Badges from "../Badges.astro";
import Section from "../../layout/Section.astro";
import StepCarousel from "../../ui/StepCarousel.astro";
import StepPanel from "../../ui/StepPanel.astro";

interface StepImage {
  src: string;
  alt: string;
}

interface Step {
  title: string;
  description: string;
  images: StepImage[];
  badges?: boolean;
}

const steps: Step[] = [
  {
    title: "Bienvenido a dabetai",
    description: "Descarga la aplicación y crea tu cuenta como paciente para acceder a tu perfil de salud, conectar dispositivos y recibir recomendaciones personalizadas basadas en inteligencia artificial.",
    images: [
      { src: "/assets/images/mobile/splash.png", alt: "Pantalla de bienvenida dabetai" },
      { src: "/assets/images/mobile/welcome.png", alt: "Registro e inicio de sesión" },
    ],
    badges: true,
  },
  {
    title: "Completa tu perfil de salud",
    description: "Responde un onboarding rápido donde nos cuentas tu tipo de diabetes, desde cuándo la tienes, si tienes hipertensión, tu edad, género, estatura y peso. Así la IA puede ofrecerte predicciones más precisas.",
    images: [
      { src: "/assets/images/mobile/onboarding.png", alt: "Onboarding perfil de salud" },
    ],
  },
  {
    title: "Conecta tus dispositivos",
    description: "Sigue el asistente paso a paso para vincular tu monitor de glucosa continuo (CGM) y wearables compatibles. La app se sincronizará automáticamente para capturar tus biomarcadores.",
    images: [
      { src: "/assets/images/mobile/connect-devices.png", alt: "Conexión de dispositivos" },
      { src: "/assets/images/mobile/device-connected.png", alt: "Dispositivos conectados" },
    ],
  },
  {
    title: "Conecta apps de salud",
    description: "Vincula aplicaciones como Apple Health o Google Fit para centralizar todos tus datos de salud en un solo lugar y enriquecer el análisis de la inteligencia artificial.",
    images: [
      { src: "/assets/images/mobile/connect-apps.png", alt: "Conexión de apps de salud" },
      { src: "/assets/images/mobile/apps-connected.png", alt: "Apps de salud conectadas" },
    ],
  },
  {
    title: "Vincula a tu médico",
    description: "Conecta tu cuenta con la de tu médico a través del portal web. El asistente te guía en el proceso para que pueda supervisar tus métricas y alertas en tiempo real.",
    images: [
      { src: "/assets/images/mobile/connect-doctor.png", alt: "Vinculación con médico" },
      { src: "/assets/images/mobile/doctor-connected.png", alt: "Mi médico conectado" },
    ],
  },
  {
    title: "Explora tu ecosistema",
    description: "Accede al panel principal con tu dashboard de métricas, predicciones de complicaciones, historial completo y un chat con IA para resolver todas tus dudas al instante.",
    images: [
      { src: "/assets/images/mobile/dashboard.png", alt: "Panel principal dabetai" },
      { src: "/assets/images/mobile/predictions.png", alt: "Predicción de complicaciones" },
      { src: "/assets/images/mobile/historial.png", alt: "Historial completo" },
      { src: "/assets/images/mobile/chat.png", alt: "Chat con IA" },
    ],
  },
];
---

<Section bgColor="bg-primary-50">
  <StepCarousel totalSteps={steps.length} color="primary">
    {steps.map((step, i) => (
      <StepPanel step={step} index={i} hidden={i !== 0} accent="primary" imgClass="w-72 mx-auto" singleImgClass="w-72">
        {step.badges && <Badges className="justify-center w-full" />}
      </StepPanel>
    ))}
  </StepCarousel>
</Section>
