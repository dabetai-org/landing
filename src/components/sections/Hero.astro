---
import type { Dictionary } from "../../i18n/types";
import Badges from "./Badges.astro";
import Section from "../layout/Section.astro";
import Typography from "../ui/Typography.astro";

const { dict } = Astro.props as { dict: Dictionary };
---

<Section id="hero" bgColor="bg-primary-500" innerClass="md:flex-row justify-between items-center">
  <div class="max-w-lg space-y-6 md:space-y-8 text-center md:text-left shrink-0" data-reveal>
    <Typography variant="h1" color="text-slate-50">
      {dict.hero.titleBefore}<span class="text-white text-4xl" style="text-shadow: 0 0 8px rgba(255,255,255,0.15), 0 0 20px rgba(33,150,243,0.15);">{dict.hero.highlightedText}</span>{dict.hero.titleAfter}
    </Typography>

    <Typography variant="body" color="text-slate-50" class="md:!text-lg md:!leading-[22.6px] !font-medium">
      {dict.hero.description}
    </Typography>

    <Badges className="justify-center md:justify-start" dict={dict} />
  </div>

  <div class="relative w-full sm:max-w-xl lg:max-w-3xl flex items-end justify-center" data-reveal="right">
    <img src="/assets/images/web/features/dashboard.png" alt={dict.alt.webDashboard} class="w-full h-auto transition-transform duration-[2000ms] ease-in-out hover:scale-105 animate-float" />
    <img src="/assets/images/mobile/dashboard.png" alt={dict.alt.mobileDashboard} class="w-2/5 sm:w-1/3 h-auto -ml-6 xs:-ml-10 sm:-ml-16 lg:-ml-20 translate-y-4 xs:translate-y-6 sm:translate-y-8 lg:translate-y-10 transition-transform duration-[2000ms] ease-in-out hover:scale-105 animate-float-delayed" />
  </div>
</Section>
