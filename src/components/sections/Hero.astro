---
import type { Dictionary } from "../../i18n/types";
import Badges from "./Badges.astro";
import Section from "../layout/Section.astro";
import Typography from "../ui/Typography.astro";

const { dict } = Astro.props as { dict: Dictionary };
---

<Section id="hero" bgColor="bg-primary-500">
  <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-10 sm:gap-12 lg:gap-16 items-center">
    <div class="max-w-lg mx-auto md:mx-0 space-y-8 md:space-y-10 text-center md:text-left" data-reveal>
      <Typography variant="display" color="text-slate-50">
        {dict.hero.titleBefore}<span class="text-white" style="text-shadow: 0 0 8px rgba(255,255,255,0.15), 0 0 20px rgba(33,150,243,0.15);">{dict.hero.highlightedText}</span>{dict.hero.titleAfter}
      </Typography>

      <Typography variant="body" color="text-slate-50" class="!text-base sm:!text-lg md:!text-xl lg:!text-2xl md:!leading-[26px] lg:!leading-[30px] !font-medium">
        {dict.hero.description}
      </Typography>

      <Badges className="justify-center md:justify-start" dict={dict} />
    </div>

    <div class="relative md:flex md:items-end md:justify-center" data-reveal="right">
      <!-- Mobile: full width, Desktop: flex item taking space -->
      <img src="/assets/images/web/features/dashboard.png" alt={dict.alt.webDashboard} width="3112" height="2590" class="w-full min-w-0 h-auto transition-transform duration-[2000ms] ease-in-out hover:scale-105 animate-float" />

      <!-- Mobile: overlaid at bottom center, Desktop: side-by-side overlap -->
      <img src="/assets/images/mobile/dashboard.png" alt={dict.alt.mobileDashboard} width="511" height="895" class="
        absolute bottom-2 left-1/2 -translate-x-1/2 w-1/2 max-w-[160px]
        md:relative md:bottom-auto md:left-auto md:translate-x-0
        md:max-w-none md:min-w-0 md:w-1/3 md:-ml-6 lg:-ml-20
        md:translate-y-8 lg:translate-y-10
        h-auto transition-transform duration-[2000ms] ease-in-out hover:scale-105 animate-float-delayed" />
    </div>
  </div>
</Section>
