---
import Badges from "./Badges.astro";
import Section from "../layout/Section.astro";
import Typography from "../ui/Typography.astro";
---

<Section id="hero" bgColor="bg-primary-500" innerClass="md:flex-row justify-between items-center">
  <div class="max-w-lg space-y-6 md:space-y-8 text-center md:text-left shrink-0">
    <Typography variant="h1" color="text-slate-50">
      Predice y prevén complicaciones de la diabetes con <span class="text-white" style="text-shadow: 0 0 8px rgba(255,255,255,0.15), 0 0 20px rgba(33,150,243,0.15);">inteligencia artificial</span>
    </Typography>

    <Typography variant="body" color="text-slate-50" class="md:!text-lg md:!leading-[22.6px] !font-medium">
      Conecta tu monitor de glucosa continuo (CGM) y wearables para que la IA analice tus biomarcadores, te alerte sobre riesgos de complicaciones antes de que sean irreversibles y mantenga a tu médico al tanto mediante el portal de supervisión remota.
    </Typography>

    <Badges className="justify-center md:justify-start" />
  </div>

  <div class="relative w-full sm:max-w-xl lg:max-w-3xl flex items-end justify-center">
    <img src="/assets/images/web/features/dashboard.png" alt="Web app" class="w-full h-auto transition-transform duration-[2000ms] ease-in-out hover:scale-105" />
    <img src="/assets/images/mobile/dashboard.png" alt="Mobile app" class="w-2/5 sm:w-1/3 h-auto -ml-6 xs:-ml-10 sm:-ml-16 lg:-ml-20 translate-y-4 xs:translate-y-6 sm:translate-y-8 lg:translate-y-10 transition-transform duration-[2000ms] ease-in-out hover:scale-105" />
  </div>
</Section>
