---
import Section from "../../layout/Section.astro";
import Typography from "../../ui/Typography.astro";
import Button from "../../ui/Button.astro";
import ButtonGroup from "../../ui/ButtonGroup.astro";
---

<Section bgColor="bg-slate-50" innerClass="lg:flex-row justify-between items-center">
  <div class="flex flex-col gap-4 sm:gap-5 text-center lg:text-left">
    <Typography variant="h1" color="text-slate-950">
      Supervisa a tus pacientes con alertas predictivas de IA
    </Typography>
    <Typography variant="body">
      Regístrate, vincula a tus pacientes y recibe alertas automáticas ante cualquier riesgo detectado por la IA.
    </Typography>
  </div>

  <ButtonGroup direction="row" stackAt="lg" stretch gap={4} class="justify-center lg:justify-end self-start w-full lg:w-auto">
    <Button title="Iniciar sesión" variant="fill" color="secondary" href="#" disabled tooltip="Próximamente" class="!opacity-80" />
    <Button title="Registrarse" variant="outline" color="secondary" href="#" disabled tooltip="Próximamente" class="!opacity-80" />
  </ButtonGroup>
</Section>
