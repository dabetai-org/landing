---
import Section from "../../layout/Section.astro";
import Typography from "../../ui/Typography.astro";
import ImageGallery from "../../ui/ImageGallery.astro";

const professionalFeatures = [
  {
    title: "Supervisión remota de pacientes",
    description: "Conéctate con las cuentas de tus pacientes y accede a sus métricas de glucosa, biomarcadores y alertas en tiempo real.",
    icon: "fa-user-md",
  },
  {
    title: "Alertas de riesgo por IA",
    description: "Recibe notificaciones cuando los modelos detecten riesgo de retinopatía, nefropatía u otras complicaciones.",
    icon: "fa-brain",
  },
  {
    title: "Reportes clínicos automatizados",
    description: "Genera informes detallados del estado de salud de cada paciente con datos objetivos, predicciones y evolución temporal.",
    icon: "fa-notes-medical",
  },
  {
    title: "Intervención a distancia y chat IA",
    description: "Comunícate con tus pacientes, ajusta tratamientos y usa el chat con IA para consultar métricas y resolver dudas al instante.",
    icon: "fa-chart-line",
  },
];
---

<Section id="web-app-features" bgColor="bg-slate-100">
  <Typography variant="h1" color="text-slate-950" class="text-center">
    Seguimiento para profesionales de la salud
  </Typography>

  <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-6">
    <div class="col-span-2 flex justify-center order-last md:order-none">
      <ImageGallery
        images={[
          { src: "/assets/images/web/features/dashboard.png", alt: "Panel principal dabetai web" },
          { src: "/assets/images/web/features/patients.png", alt: "Panel principal dabetai web" },
          { src: "/assets/images/web/features/predictions.png", alt: "Predicciones y alertas" },
          { src: "/assets/images/web/features/aichat.png", alt: "Chat con IA" },
          { src: "/assets/images/web/features/notifications.png", alt: "Notificaciones" },
        ]}
        imgClass="w-4/5"
        color="secondary"
      />
    </div>

    <div class="col-span-1 flex flex-col h-full justify-between space-y-6">
      {professionalFeatures.map((feature) => (
        <div class="flex items-center gap-5">
          <div class="w-14 h-14 flex items-center justify-center bg-slate-50 text-secondary-500 rounded-full text-2xl shrink-0 shadow-ds-sm">
            <i class={`fas ${feature.icon}`} />
          </div>
          <div class="space-y-3">
            <Typography variant="subtitle" color="text-secondary-500">{feature.title}</Typography>
            <Typography variant="body">{feature.description}</Typography>
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>
