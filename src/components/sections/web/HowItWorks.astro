---
import Section from "../../layout/Section.astro";
import Button from "../../ui/Button.astro";
import ButtonGroup from "../../ui/ButtonGroup.astro";
import StepCarousel from "../../ui/StepCarousel.astro";
import StepPanel from "../../ui/StepPanel.astro";

interface StepImage {
  src: string;
  alt: string;
}

interface Step {
  title: string;
  description: string;
  images: StepImage[];
  buttons?: boolean;
}

const steps: Step[] = [
  {
    title: "Inicia sesión o regístrate",
    description: "Accede al portal médico con tu cuenta profesional o crea una nueva. Una vez dentro, tendrás acceso al panel de control con las métricas de tus pacientes.",
    images: [
      { src: "/assets/images/web/login.png", alt: "Inicio de sesión portal médico" },
    ],
    buttons: true,
  },
  {
    title: "Panel de control",
    description: "Visualiza el dashboard general con las métricas clave de todos tus pacientes, su estado actual y alertas activas en tiempo real.",
    images: [
      { src: "/assets/images/web/dashboard.png", alt: "Dashboard de métricas" },
    ],
  },
  {
    title: "Gestión de pacientes",
    description: "Administra tus pacientes desde un panel centralizado. Agrega nuevos pacientes, revisa su historial clínico, métricas y da seguimiento personalizado a cada caso.",
    images: [
      { src: "/assets/images/web/patients.png", alt: "Panel general de pacientes" },
      { src: "/assets/images/web/add-patient.png", alt: "Agregar nuevo paciente" },
    ],
  },
  {
    title: "Predicciones y chat con IA",
    description: "Accede a las predicciones de riesgo de complicaciones generadas por la IA para cada paciente, recibe notificaciones automáticas ante cualquier anomalía y resuelve tus dudas al instante con el asistente de inteligencia artificial integrado.",
    images: [
      { src: "/assets/images/web/predictions.png", alt: "Predicciones con IA" },
      { src: "/assets/images/web/chat.png", alt: "Chat con IA" },
      { src: "/assets/images/web/notifications.png", alt: "Notificaciones de riesgo" },
    ],
  },
];
---

<Section bgColor="bg-secondary-50">
  <StepCarousel totalSteps={steps.length} color="secondary">
    {steps.map((step, i) => (
      <StepPanel step={step} index={i} hidden={i !== 0} accent="secondary" imgClass="w-full max-w-5xl mx-auto" singleImgClass="w-full max-w-5xl rounded-lg shadow-ds-md">
        {step.buttons && (
          <ButtonGroup direction="row" align="center" stretch>
            <Button title="Iniciar sesión" variant="fill" color="secondary" href="#" disabled tooltip="Próximamente" class="!opacity-80" />
            <Button title="Registrarse" variant="outline" color="secondary" href="#" disabled tooltip="Próximamente" class="!opacity-80" />
          </ButtonGroup>
        )}
      </StepPanel>
    ))}
  </StepCarousel>
</Section>
