---
import type { Dictionary } from "../../../i18n/types";
import Section from "../../layout/Section.astro";
import Button from "../../ui/Button.astro";
import ButtonGroup from "../../ui/ButtonGroup.astro";
import StepCarousel from "../../ui/StepCarousel.astro";
import StepPanel from "../../ui/StepPanel.astro";

const { dict } = Astro.props as { dict: Dictionary };
const steps = dict.webHowItWorks.steps;
const labels = dict.webHowItWorks;
---

<Section bgColor="bg-secondary-50">
  <div data-reveal>
  <StepCarousel totalSteps={steps.length} color="secondary">
    {steps.map((step, i) => (
      <StepPanel step={step} index={i} hidden={i !== 0} accent="secondary" imgClass="w-full max-w-5xl mx-auto" singleImgClass="w-full max-w-5xl rounded-lg shadow-ds-md">
        {step.buttons && (
          <ButtonGroup direction="row" align="center" stretch>
            <Button title={labels.loginButton} variant="fill" color="secondary" href="#" disabled tooltip={labels.comingSoon} class="!opacity-80" />
            <Button title={labels.registerButton} variant="outline" color="secondary" href="#" disabled tooltip={labels.comingSoon} class="!opacity-80" />
          </ButtonGroup>
        )}
      </StepPanel>
    ))}
  </StepCarousel>
  </div>
</Section>
