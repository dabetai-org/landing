---
import Typography from "./Typography.astro";

export type InputState = "default" | "focus" | "disabled" | "error" | "valid";

export interface Props {
  label?: string;
  name: string;
  placeholder?: string;
  value?: string;
  state?: InputState;
  feedback?: string;
  disabled?: boolean;
  required?: boolean;
  rows?: number;
  class?: string;
}

const {
  label,
  name,
  placeholder,
  value,
  state = "default",
  feedback,
  disabled = false,
  required = false,
  rows = 3,
  class: className = "",
} = Astro.props;

const stateClasses: Record<InputState, string> = {
  default: "border-slate-300",
  focus: "border-primary-700",
  disabled: "border-slate-300 bg-slate-200 text-slate-600",
  error: "border-danger-800",
  valid: "border-success-800",
};

const feedbackColor = state === "error" ? "text-danger-800" : "text-success-800";
---

<div class={`flex flex-col gap-2 ${className}`}>
  {label && (
    <label for={name}>
      <Typography variant="body" tag="span">{label}</Typography>
    </label>
  )}
  <textarea
    id={name}
    name={name}
    placeholder={placeholder}
    rows={rows}
    disabled={disabled || state === "disabled"}
    required={required}
    class={`px-4 py-3 rounded-lg border bg-slate-50 font-inter text-base leading-[19.4px] text-slate-700 placeholder:text-slate-500 focus:outline-none resize-y ${stateClasses[state]}`}
  >{value}</textarea>
  {feedback && (
    <Typography variant="caption" tag="span" color={feedbackColor}>{feedback}</Typography>
  )}
</div>
