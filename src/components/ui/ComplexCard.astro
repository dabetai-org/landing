---
import Typography from "./Typography.astro";

export interface Props {
  title: string;
  description: string;
  direction?: "horizontal" | "vertical";
  variant?: "default" | "stroke";
  assetType?: "image" | "icon";
  class?: string;
}

const {
  title,
  description,
  direction = "horizontal",
  variant = "default",
  assetType,
  class: className = "",
} = Astro.props;

const directionClasses = direction === "horizontal" ? "flex-row items-center" : "flex-col";
const variantClasses = variant === "stroke" ? "border border-slate-300 bg-slate-50" : "";
const gap = "gap-3";
const padding = "p-4";
---

<div class={`flex ${directionClasses} ${variantClasses} ${gap} ${padding} rounded-2xl shadow-ds-sm ${className}`}>
  {assetType && (
    <div class={`${direction === "horizontal" ? "w-16 h-16" : "w-full h-32"} bg-slate-100 rounded-xl flex items-center justify-center shrink-0`}>
      {assetType === "image" ? (
        <slot name="image" />
      ) : (
        <div class="w-6 h-6 text-slate-700">
          <slot name="icon" />
        </div>
      )}
    </div>
  )}
  <div class={`${direction === "horizontal" ? "flex-1" : ""} ${gap} flex flex-col`}>
    <Typography variant="h3">{title}</Typography>
    <Typography variant="body">{description}</Typography>
    <slot name="actions" />
  </div>
</div>
