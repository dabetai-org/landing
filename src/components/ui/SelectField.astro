---
import Typography from "./Typography.astro";

export type InputState = "default" | "focus" | "disabled" | "error" | "valid";

export interface Props {
  label?: string;
  name: string;
  placeholder?: string;
  state?: InputState;
  feedback?: string;
  disabled?: boolean;
  required?: boolean;
  class?: string;
}

const {
  label,
  name,
  placeholder,
  state = "default",
  feedback,
  disabled = false,
  required = false,
  class: className = "",
} = Astro.props;

const stateClasses: Record<InputState, string> = {
  default: "border-slate-300",
  focus: "border-primary-700",
  disabled: "border-slate-300 bg-slate-200 text-slate-600",
  error: "border-danger-800",
  valid: "border-success-800",
};

const feedbackColor = state === "error" ? "text-danger-800" : "text-success-800";
---

<div class={`flex flex-col gap-2 ${className}`}>
  {label && (
    <label for={name}>
      <Typography variant="body" tag="span">{label}</Typography>
    </label>
  )}
  <div class={`flex items-center gap-2.5 px-4 py-3 rounded-lg border bg-slate-50 ${stateClasses[state]}`}>
    <slot name="icon" />
    <select
      id={name}
      name={name}
      disabled={disabled || state === "disabled"}
      required={required}
      class="flex-1 bg-transparent font-inter text-base leading-[19.4px] text-slate-700 focus:outline-none"
    >
      {placeholder && <option value="" disabled selected>{placeholder}</option>}
      <slot />
    </select>
  </div>
  {feedback && (
    <Typography variant="caption" tag="span" color={feedbackColor}>{feedback}</Typography>
  )}
</div>
