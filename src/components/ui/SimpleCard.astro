---
import Typography from "./Typography.astro";

export interface Props {
  title: string;
  description: string;
  icon: string;
  color?: "primary" | "secondary";
  colorShade?: "500" | "700";
  iconPosition?: "left" | "right";
  "data-reveal"?: string;
  style?: string;
  class?: string;
}

const {
  title,
  description,
  icon,
  color = "primary",
  colorShade = "500",
  iconPosition = "left",
  "data-reveal": dataReveal,
  style,
  class: className = "",
} = Astro.props;

const textColor = `text-${color}-${colorShade}`;
const rowDir = iconPosition === "right" ? "flex-row-reverse" : "flex-row";
const textAlign = iconPosition === "right" ? "text-end" : "text-start";
---

<div
  class={`flex ${rowDir} items-center gap-5 ${className}`}
  data-reveal={dataReveal}
  style={style}
>
  <div class={`w-14 h-14 flex items-center justify-center bg-slate-50 border border-slate-300 rounded-2xl ${textColor} text-2xl shrink-0`}>
    <i class={`fas ${icon}`} />
  </div>
  <div class={`${textAlign} space-y-3`}>
    <Typography variant="subtitle" color={textColor}>{title}</Typography>
    <Typography variant="body">{description}</Typography>
  </div>
</div>