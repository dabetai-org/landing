---
import Typography from "./Typography.astro";
import ImageGallery from "./ImageGallery.astro";

interface StepImage {
  src: string;
  alt: string;
}

interface Props {
  step: {
    title: string;
    description: string;
    images: StepImage[];
  };
  index?: number;
  hidden?: boolean;
  accent?: "primary" | "secondary";
  imgClass?: string;
  singleImgClass?: string;
}

const { step, index = 0, hidden = false, accent = "primary", imgClass = "", singleImgClass = "" } = Astro.props;
const titleColor = accent === "secondary" ? "text-secondary-500" : "text-primary-500";
const singleImgBase = "object-contain mx-auto transition-all duration-500 hover:scale-[1.02] " + singleImgClass;
---

<div class="step-panel" class:list={{ hidden }} data-index={index}>
  <div class="text-center space-y-6 sm:max-w-xl mx-auto">
    <Typography variant="subtitle" color={titleColor}>
      {step.title}
    </Typography>
    {step.images.length > 1 ? (
      <ImageGallery images={step.images} imgClass={imgClass} color={accent} autoPlay={false} />
    ) : (
      <img src={step.images[0].src} alt={step.images[0].alt} class={singleImgBase} />
    )}
    <Typography variant="body">
      {step.description}
    </Typography>
    <slot />
  </div>
</div>
