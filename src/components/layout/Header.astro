---
import type { Dictionary } from "../../i18n/types";
import type { Locale } from "../../i18n/config";

interface LinkItem {
  href: string;
  label: string;
}

const { links = [], dict, lang } = Astro.props as { links?: LinkItem[]; dict: Dictionary; lang: Locale };
const otherLang = lang === "en" ? "es" : "en";
const otherLabel = lang === "en" ? "ES" : "EN";
const otherFullLabel = lang === "en" ? "Español" : "English";
---

<header id="app-header" class="fixed top-0 left-0 w-full z-50 transition-[background-color,transform] duration-300 bg-primary-500 border-b border-white/20">
  <div class="max-w-[1440px] mx-auto px-5 xs:px-6 md:px-20 flex items-center justify-between h-16 md:h-[72px]">
      <a href={lang === "en" ? "/en" : "/"} class="shrink-0 hover:scale-110 active:scale-95 transition-all duration-300">
        <img id="header-logo" src="/assets/images/logo/logo-dark.png" alt="dabetai" class="h-6 xs:h-7 sm:h-8" />
      </a>

    <nav class="hidden md:flex items-center gap-1">
      {links.map((link) => (
        <a
          href={link.href}
          data-section={link.href.replace("#", "")}
           class="nav-link px-5 py-2.5 leading-none text-sm font-bold transition-all duration-200 rounded-xl text-white/80 hover:text-white hover:bg-white/10 active:scale-95"
        >
          {link.label}
        </a>
      ))}
      <a
        href={lang === "en" ? "/es" : "/en"}
        id="lang-toggle"
        data-other-lang={otherLang}
        class="nav-lang ml-2 px-3 py-2.5 leading-none text-xs font-black uppercase tracking-wider transition-all duration-200 rounded-xl text-white/80 hover:text-white hover:bg-white/10 active:scale-95 border border-white/20 flex items-center gap-1.5"
      >
        <i class="fa-solid fa-globe text-sm"></i>
        {otherLabel}
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a
        href={lang === "en" ? "/es" : "/en"}
        id="lang-toggle-mobile"
        data-other-lang={otherLang}
        class="px-3 py-2.5 leading-none text-xs font-black uppercase tracking-wider transition-all duration-200 rounded-xl text-white/80 hover:text-white hover:bg-white/15 active:scale-95 border border-white/20 flex items-center gap-1.5"
      >
        <i class="fa-solid fa-globe text-sm"></i>
        {otherLabel}
      </a>
      <button
        id="menu-btn"
        type="button"
        class="px-3 py-2.5 leading-none rounded-xl text-white hover:bg-white/15 active:scale-95 transition-all cursor-pointer border border-white/20"
        aria-label={dict.openMenu}
      >
        <i id="menu-icon" class="fa-solid fa-bars text-sm"></i>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="fixed inset-0 z-50 flex flex-col w-full h-full overflow-hidden hidden bg-primary-500">
  <div class="flex items-center justify-between px-5 xs:px-6 h-16 shrink-0 border-b border-white/20">
    <a href={lang === "en" ? "/en" : "/"}>
      <img id="mobile-logo" src="/assets/images/logo/logo-white.png" alt="dabetai" class="h-6 xs:h-7" />
    </a>
      <button
        id="menu-close"
        type="button"
        class="px-3 py-2.5 leading-none rounded-xl text-white/80 hover:text-white hover:bg-white/15 active:scale-95 transition-all cursor-pointer border border-white/20"
        aria-label={dict.closeMenu}
      >
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
  </div>

  <div class="flex-1 flex flex-col p-5 sm:p-6 gap-2 overflow-y-auto">
    <nav class="flex flex-col gap-2 mt-2">
      {links.map((link, idx) => (
        <a
          href={link.href}
          data-section={link.href.replace("#", "")}
          class="mobile-nav-link flex items-center justify-between p-3 sm:p-4 rounded-xl sm:rounded-2xl border border-white/20 bg-white/10 text-white/80 hover:text-white hover:bg-white/20 transition-all duration-200"
        >
          <span class="text-base sm:text-lg font-bold">{link.label}</span>
          <span class="text-xs sm:text-sm font-black opacity-50">0{idx + 1}</span>
        </a>
      ))}
      <a
        href={lang === "en" ? "/es" : "/en"}
        data-other-lang={otherLang}
        class="mobile-nav-link flex items-center justify-between p-3 sm:p-4 rounded-xl sm:rounded-2xl border border-white/20 bg-white/10 text-white/80 hover:text-white hover:bg-white/20 transition-all duration-200 mt-4"
      >
        <span class="text-base sm:text-lg font-bold">{otherFullLabel}</span>
        <i class="fa-solid fa-globe text-sm opacity-50"></i>
      </a>
    </nav>

    <div class="mt-auto py-6 flex flex-col gap-4 items-center border-t border-white/20">
      <div class="flex gap-5 items-center">
        <a
          href="https://github.com/dabetai-org"
          target="_blank"
          rel="noopener noreferrer"
          title="GitHub"
          class="text-white/60 hover:text-white transition-all hover:scale-110 active:scale-90"
        >
          <i class="fab fa-github text-lg"></i>
        </a>
        <a
          href="https://www.linkedin.com/in/chrisssp/"
          target="_blank"
          rel="noopener noreferrer"
          title="LinkedIn"
          class="text-white/60 hover:text-white transition-all hover:scale-110 active:scale-90"
        >
          <i class="fab fa-linkedin text-lg"></i>
        </a>
        <a
          href="mailto:christian.serrano.puertos@gmail.com"
          title="Email"
          class="text-white/60 hover:text-white transition-all hover:scale-110 active:scale-90"
        >
          <i class="fas fa-envelope text-lg"></i>
        </a>
      </div>
      <span class="text-white/40 text-xs font-medium">&copy; 2025 {dict.footer.copyright}</span>
    </div>
  </div>
</div>

<style>
  .nav-link.active {
    color: white;
    background-color: rgba(255, 255, 255, 0.15);
  }
  .mobile-nav-link.active {
    color: white;
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
  }
</style>

<script>
  (function () {
    var header = document.getElementById("app-header");
    var menuBtn = document.getElementById("menu-btn");
    var menuClose = document.getElementById("menu-close");
    var mobileMenu = document.getElementById("mobile-menu");
    var mobileLogo = document.getElementById("mobile-logo");
    var navLinks = document.querySelectorAll(".nav-link");
    var mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
    var allNavLinks = document.querySelectorAll("[data-section]");
    var lastScrollY = 0;
    var mobileMenuOpen = false;

    var SECTION_ORDER = [
      "hero",
      "mobile-app-features",
      "ai-prediction",
      "web-app-features",
      "faq",
    ];

    var headerLogo = document.getElementById("header-logo");
    var HEADER_COLORS = {
      hero: "#2196F3",
      "mobile-app-features": "#2196F3",
      "ai-prediction": "#2196F3",
      "web-app-features": "#009688",
      faq: "#2196F3",
    };

    var LOGO_SRC = {
      hero: "/assets/images/logo/logo-dark.png",
      "mobile-app-features": "/assets/images/logo/logo-dark.png",
      "ai-prediction": "/assets/images/logo/logo-dark.png",
      "web-app-features": "/assets/images/logo/logo-secondary-dark.png",
      faq: "/assets/images/logo/logo-dark.png",
    };

    function getActiveSection() {
      var scrollY = window.scrollY + 120;
      var active = SECTION_ORDER[0];
      for (var i = 0; i < SECTION_ORDER.length; i++) {
        var el = document.getElementById(SECTION_ORDER[i]);
        if (el && el.offsetTop <= scrollY) {
          active = SECTION_ORDER[i];
        }
      }
      return active;
    }

    function updateHeader() {
      var active = getActiveSection();
      header.style.backgroundColor = HEADER_COLORS[active];
      headerLogo.src = LOGO_SRC[active];
      if (mobileMenuOpen) {
        mobileMenu.style.backgroundColor = HEADER_COLORS[active];
      }
      mobileLogo.src = LOGO_SRC[active];
      for (var i = 0; i < allNavLinks.length; i++) {
        var link = allNavLinks[i];
        if (link.dataset.section === active) {
          link.classList.add("active");
        } else {
          link.classList.remove("active");
        }
      }
    }

    function openMenu() {
      mobileMenuOpen = true;
      mobileMenu.classList.remove("hidden");
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
      header.style.transform = "translateY(0)";
      updateHeader();
    }

    function closeMenu() {
      mobileMenuOpen = false;
      mobileMenu.classList.add("hidden");
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
    }

    menuBtn.addEventListener("click", openMenu);
    menuClose.addEventListener("click", closeMenu);

    mobileMenu.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", closeMenu);
    });

    var langToggles = document.querySelectorAll("[data-other-lang]");
    langToggles.forEach(function (toggle) {
      toggle.addEventListener("click", function (e) {
        e.preventDefault();
        var otherLang = toggle.getAttribute("data-other-lang");
        var hash = window.location.hash;
        window.location.href = "/" + otherLang + hash;
      });
    });

    window.addEventListener(
      "scroll",
      function () {
        var currentScrollY = window.scrollY;
        if (!mobileMenuOpen) {
          if (currentScrollY > lastScrollY && currentScrollY > 80) {
            header.style.transform = "translateY(-100%)";
          } else {
            header.style.transform = "translateY(0)";
          }
        }
        lastScrollY = currentScrollY;
        updateHeader();
      },
      { passive: true }
    );

    updateHeader();
  })();
</script>
