---
import Badges from "../sections/Badges.astro";
import Typography from "../ui/Typography.astro";

interface LinkItem {
  href: string;
  label: string;
}

interface TeamMember {
  name: string;
  github: { user: string; url: string } | null;
  linkedin: { user: string; url: string } | null;
  email: string | null;
}

const {
  navLinks = [],
  resources = [],
  teamMembers = [],
} = Astro.props as {
  navLinks?: LinkItem[];
  resources?: LinkItem[];
  teamMembers?: TeamMember[];
};
---

<footer class="w-full bg-primary-500 py-12 select-none">
  <div class="max-w-[1440px] mx-auto px-5 xs:px-6 md:px-20 space-y-12">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 xs:gap-10 md:gap-14 text-slate-50"
    >
      <div class="space-y-5 flex flex-col">
        <a
          href="/"
          class="self-start hover:scale-110 active:scale-95 transition-all duration-300"
        >
          <img
            src="/assets/images/logo/logo-dark.png"
            alt="dabetai - Ecosistema de monitoreo y predicción de complicaciones diabéticas con IA"
            class="h-8 xs:h-9 sm:h-10"
          />
        </a>
        <Typography variant="body" color="text-slate-50"
          >Ecosistema inteligente de monitoreo y predicción de complicaciones
          diabéticas mediante inteligencia artificial, wearables y monitores de
          glucosa continuos.</Typography
        >
        <Badges className="w-60" />
        <Typography
          variant="caption"
          color="text-slate-50"
          class="opacity-60 !text-inherit mt-auto pt-4"
          >&copy; 2025 dabetai</Typography
        >
      </div>

      <div class="flex flex-col space-y-5">
        <Typography variant="subtitle" color="text-slate-50" tag="h4"
          >Navegación</Typography
        >
        <ul class="space-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-primary-100 transition-colors"
                >
                  <Typography variant="body" color="!text-inherit">
                    {link.label}
                  </Typography>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col space-y-5">
        <Typography variant="subtitle" color="text-slate-50" tag="h4"
          >Recursos útiles</Typography
        >
        <ul class="space-y-2">
          {
            resources.map((resource) => (
              <li>
                <a
                  href={resource.href}
                  class="hover:text-primary-100 transition-colors"
                >
                  <Typography variant="body" color="!text-inherit">
                    {resource.label}
                  </Typography>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col space-y-5">
        <Typography variant="subtitle" color="text-slate-50" tag="h4"
          >Equipo</Typography
        >
        <ul class="space-y-3">
          {
            teamMembers.map((member) => (
              <li class="space-y-1">
                <Typography
                  variant="caption"
                  color="text-primary-100"
                  class="block !text-xs !font-bold"
                >
                  {member.name}
                </Typography>
                {member.github || member.linkedin ? (
                  <div class="flex items-center gap-2">
                    {member.github && (
                      <a
                        href={member.github.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-primary-100 transition-colors flex items-center gap-1.5"
                      >
                        <i class="fab fa-github text-sm" />
                        <Typography variant="caption" color="!text-inherit">
                          {member.github.user}
                        </Typography>
                      </a>
                    )}
                    {member.github && member.linkedin && (
                      <span class="text-slate-50/40">|</span>
                    )}
                    {member.linkedin && (
                      <a
                        href={member.linkedin.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-primary-100 transition-colors flex items-center gap-1.5"
                      >
                        <i class="fab fa-linkedin text-sm" />
                        <Typography variant="caption" color="!text-inherit">
                          {member.linkedin.user}
                        </Typography>
                      </a>
                    )}
                  </div>
                ) : null}
                {member.email && (
                  <a
                    href={`mailto:${member.email}`}
                    class="hover:text-primary-100 transition-colors flex items-center gap-1.5"
                  >
                    <i class="fas fa-envelope text-sm" />
                    <Typography variant="caption" color="!text-inherit">
                      {member.email}
                    </Typography>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
