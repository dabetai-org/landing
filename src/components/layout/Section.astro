---
const { bgColor = "", innerClass = "", id = "" } = Astro.props;
---

  <section id={id} class={`w-full py-10 sm:py-16 lg:py-[120px] scroll-mt-20 md:scroll-mt-[88px] ${bgColor}`}>
  <div class={`max-w-[1440px] mx-auto px-5 xs:px-6 md:px-20 flex flex-col gap-8 sm:gap-10 lg:gap-12 ${innerClass}`}>
    <slot />
  </div>
</section>
