---
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";

const menuLinks = [
	{ label: "Inicio", href: "#hero" },
	{ label: "Aplicación móvil", href: "#mobile-app-features" },
	{ label: "Aplicación web", href: "#web-app-features" },
	{ label: "FAQ", href: "#faq" },
];

const resources = [
	{ label: "Repositorio en GitHub", href: "https://github.com/dabetai-org" },
	{ label: "Paper de investigación", href: "https://chrisssp.vercel.app/assets/docs/papers/Prevenci%C3%B3n-de-Riesgos-de-la-Diabetes-Mediante-una-Plataforma-Inteligente-de-Monitorizaci%C3%B3n-y-Predicci%C3%B3n-de-Complicaciones-con-Inteligencia-Artificial.pdf" },
	{ label: "Ver ecosistema dabetai", href: "https://chrisssp.vercel.app/es/projects/dabetai" },
];

const socialLinks = [
	{ label: "Facebook", href: "#", icon: "fa-brands fa-facebook" },
	{ label: "Instagram", href: "#", icon: "fa-brands fa-instagram" },
	{ label: "TikTok", href: "#", icon: "fa-brands fa-tiktok" },
];
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="dabetai - Ecosistema de monitoreo y predicción de complicaciones diabéticas con inteligencia artificial. App móvil para pacientes con CGM y wearables. Portal web para médicos con supervisión remota." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/assets/images/logo/isotipo-head.png" />
		<link rel="icon" href="/assets/images/logo/isotipo-head-white.png" media="(prefers-color-scheme: dark)" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
		<link rel="stylesheet" href="/styles/global.css" />
		<title>dabetai — IA para la prevención de complicaciones diabéticas</title>

		<meta property="og:title" content="dabetai — IA para la prevención de complicaciones diabéticas" />
		<meta property="og:description" content="Ecosistema de monitoreo y predicción de complicaciones diabéticas con inteligencia artificial. App móvil para pacientes con CGM y wearables. Portal web para médicos con supervisión remota." />
		<meta property="og:image" content="/assets/images/og-preview.svg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="dabetai" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="dabetai — IA para la prevención de complicaciones diabéticas" />
		<meta name="twitter:description" content="Ecosistema de monitoreo y predicción de complicaciones diabéticas con inteligencia artificial. App móvil para pacientes con CGM y wearables. Portal web para médicos con supervisión remota." />
		<meta name="twitter:image" content="/assets/images/og-preview.svg" />
		<meta name="twitter:image:width" content="1200" />
		<meta name="twitter:image:height" content="630" />
	</head>
	<body>
		<Header links={menuLinks} />
		<main class="pt-16 md:pt-[72px]">
			<slot />
		</main>
		<Footer
			navLinks={menuLinks}
			resources={resources}
			socialLinks={socialLinks}
		/>
	</body>
</html>
