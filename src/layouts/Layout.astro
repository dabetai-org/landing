---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="dabetai: app móvil con IA que predice complicaciones diabéticas conectada a tu CGM y wearables. Portal web para médicos con supervisión remota y alertas en tiempo real." />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index, follow, max-snippet:150, max-image-preview:large" />
		<link rel="canonical" href="https://dabetai.org/" />
		<link rel="icon" href="/assets/images/logo/isotipo-head.png" />
		<link rel="icon" href="/assets/images/logo/isotipo-head-white.png" media="(prefers-color-scheme: dark)" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
		<link rel="stylesheet" href="/styles/global.css" />
		<title>dabetai — Predice complicaciones de la diabetes con IA | App y portal médico</title>

		<meta property="og:title" content="dabetai — Predice complicaciones de la diabetes con IA | App y portal médico" />
		<meta property="og:description" content="App móvil con IA que predice retinopatía, nefropatía y pie diabético conectada a tu CGM y wearables. Portal web para médicos con supervisión remota." />
		<meta property="og:image" content="https://dabetai.org/assets/images/og-preview.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="dabetai" />
		<meta property="og:url" content="https://dabetai.org/" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="dabetai — Predice complicaciones de la diabetes con IA | App y portal médico" />
		<meta name="twitter:description" content="App móvil con IA que predice retinopatía, nefropatía y pie diabético conectada a tu CGM y wearables. Portal web para médicos con supervisión remota." />
		<meta name="twitter:image" content="https://dabetai.org/assets/images/og-preview.png" />
		<meta name="twitter:image:width" content="1200" />
		<meta name="twitter:image:height" content="630" />

		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "dabetai",
			"url": "https://dabetai.org",
			"logo": "https://dabetai.org/assets/images/logo/logo-dark.png",
			"description": "Ecosistema inteligente de monitoreo y predicción de complicaciones diabéticas mediante inteligencia artificial, wearables y monitores de glucosa continuos.",
			"sameAs": [
				"https://github.com/dabetai-org"
			]
		}
		</script>

		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "dabetai",
			"url": "https://dabetai.org",
			"description": "App móvil con IA que predice complicaciones diabéticas. Portal web para médicos con supervisión remota y alertas en tiempo real.",
			"inLanguage": "es-MX",
			"applicationCategory": "HealthApplication"
		}
		</script>
	</head>
	<body>
		<Header links={menuLinks} />
		<main class="pt-16 md:pt-[72px] overflow-x-clip">
			<slot />
		</main>
		<button id="back-to-top" aria-label="Volver al inicio" class="fixed bottom-6 right-6 z-50 w-10 h-10 flex items-center justify-center rounded-full bg-primary-500 text-white shadow-ds-md opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:bg-primary-700 focus:outline-none">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
		</button>

		<Footer
			navLinks={menuLinks}
			resources={resources}
			teamMembers={teamMembers}
		/>
		<script>
			(function() {
				var observer = new IntersectionObserver(function(entries) {
					entries.forEach(function(entry) {
						if (entry.isIntersecting) {
							entry.target.classList.add("revealed");
							observer.unobserve(entry.target);
						}
					});
				}, { rootMargin: "0px 0px -80px 0px", threshold: 0.1 });

				document.addEventListener("DOMContentLoaded", function() {
					document.querySelectorAll("[data-reveal]").forEach(function(el) {
						observer.observe(el);
					});
				});

				var backToTop = document.getElementById("back-to-top");
				if (backToTop) {
					backToTop.addEventListener("click", function() {
						window.scrollTo({ top: 0, behavior: "smooth" });
					});
					window.addEventListener("scroll", function() {
						if (window.scrollY > 400) {
							backToTop.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
							backToTop.classList.add("opacity-100", "translate-y-0");
						} else {
							backToTop.classList.remove("opacity-100", "translate-y-0");
							backToTop.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
						}
					});
				}
			})();
		</script>
	</body>
</html>
