---
import type { Dictionary } from "../i18n/types";
import type { Locale } from "../i18n/config";
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";

interface Props {
  dict: Dictionary;
  lang: Locale;
}

const { dict, lang } = Astro.props as Props;

const menuLinks = [
  { label: dict.nav.inicio, href: "#hero" },
  { label: dict.nav.appMovil, href: "#mobile-app-features" },
  { label: dict.nav.appWeb, href: "#web-app-features" },
  { label: dict.nav.faq, href: "#faq" },
];

const siteUrl = "https://dabetai.netlify.app";
const currentUrl = lang === "en" ? `${siteUrl}/en` : siteUrl;
const ogLocale = lang === "en" ? "en_US" : "es_MX";
const schemaLang = lang === "en" ? "en-US" : "es-MX";

const siteDescription =
  lang === "en"
    ? "dabetai: mobile app with AI that predicts diabetic complications connected to your CGM and wearables. Web portal for doctors with remote monitoring and real-time alerts."
    : "dabetai: app móvil con IA que predice complicaciones diabéticas conectada a tu CGM y wearables. Portal web para médicos con supervisión remota y alertas en tiempo real.";

const ogTitle =
  lang === "en"
    ? "dabetai — Predict diabetes complications with AI"
    : "dabetai — Predice complicaciones de diabetes con IA";

const ogDescription =
  lang === "en"
    ? "Mobile app with AI that predicts retinopathy, nephropathy, and diabetic foot connected to your CGM and wearables. Web portal for doctors with remote monitoring."
    : "App móvil con IA que predice retinopatía, nefropatía y pie diabético conectada a tu CGM y wearables. Portal web para médicos con supervisión remota.";

const wsDescription =
  lang === "en"
    ? "Mobile app with AI that predicts diabetic complications. Web portal for doctors with remote monitoring and real-time alerts."
    : "App móvil con IA que predice complicaciones diabéticas. Portal web para médicos con supervisión remota y alertas en tiempo real.";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={siteDescription} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index, follow, max-snippet:150, max-image-preview:large" />
		<link rel="canonical" href={currentUrl} />
		<link rel="alternate" hreflang="es" href={siteUrl} />
		<link rel="alternate" hreflang="en" href={`${siteUrl}/en`} />
		<link rel="alternate" hreflang="x-default" href={siteUrl} />
		<link rel="icon" href="/assets/images/logo/isotipo-head.png" />
		<link rel="icon" href="/assets/images/logo/isotipo-head-white.png" media="(prefers-color-scheme: dark)" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
		<link rel="stylesheet" href="/styles/global.css" />
		<title>{ogTitle}</title>

		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={`${siteUrl}/${lang}/og-image.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:site_name" content="dabetai" />
		<meta property="og:url" content={currentUrl} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={`${siteUrl}/${lang}/og-image.png`} />
		<meta name="twitter:image:width" content="1200" />
		<meta name="twitter:image:height" content="630" />

		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "dabetai",
			"url": "https://dabetai.org",
			"logo": "https://dabetai.org/assets/images/logo/logo-dark.png",
			"description": dict.footer.description,
			"sameAs": ["https://github.com/dabetai-org"]
		})} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "dabetai",
			"url": "https://dabetai.org",
			"description": wsDescription,
			"inLanguage": schemaLang,
			"applicationCategory": "HealthApplication"
		})} />
	</head>
	<body>
		<Header links={menuLinks} dict={dict} lang={lang} />
		<main class="pt-16 md:pt-[72px] overflow-x-clip">
			<slot />
		</main>
		<button id="back-to-top" aria-label={dict.backToTop} class="fixed bottom-6 right-6 z-50 w-10 h-10 flex items-center justify-center rounded-full bg-primary-500 text-white shadow-ds-md opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:bg-primary-700 focus:outline-none">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
		</button>

		<Footer
			dict={dict}
			navLinks={menuLinks}
		/>
		<script>
			(function() {
				var observer = new IntersectionObserver(function(entries) {
					entries.forEach(function(entry) {
						if (entry.isIntersecting) {
							entry.target.classList.add("revealed");
							observer.unobserve(entry.target);
						}
					});
				}, { rootMargin: "0px 0px -80px 0px", threshold: 0.1 });

				document.addEventListener("DOMContentLoaded", function() {
					document.querySelectorAll("[data-reveal]").forEach(function(el) {
						observer.observe(el);
					});
				});

				var backToTop = document.getElementById("back-to-top");
				if (backToTop) {
					backToTop.addEventListener("click", function() {
						window.scrollTo({ top: 0, behavior: "smooth" });
					});
					window.addEventListener("scroll", function() {
						if (window.scrollY > 400) {
							backToTop.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
							backToTop.classList.add("opacity-100", "translate-y-0");
						} else {
							backToTop.classList.remove("opacity-100", "translate-y-0");
							backToTop.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
						}
					});
				}
			})();
		</script>
	</body>
</html>
